"use client"

import { useState } from "react"
import { ArrowLeft, CreditCard, Bell, User, ChevronRight } from "lucide-react"
import Link from "next/link"

export default function SettingsPage() {
  const [name, setName] = useState("V")
  const [email, setEmail] = useState("you@example.com")
  const [pushEnabled, setPushEnabled] = useState(true)
  const [txAlerts, setTxAlerts] = useState(true)
  const [marketingEmails, setMarketingEmails] = useState(false)

  return (
    <div className="min-h-screen bg-black text-white">
      <header className="sticky top-0 z-30 flex items-center gap-3 border-b border-neutral-900 bg-black/80 px-4 py-4 backdrop-blur">
        <Link
          href="/"
          aria-label="Back"
          className="flex size-10 items-center justify-center rounded-full text-neutral-300 transition-colors hover:bg-neutral-900 hover:text-white"
        >
          <ArrowLeft className="size-6" />
        </Link>
        <span className="text-base font-semibold tracking-tight">Settings</span>
      </header>

      <main className="mx-auto flex w-full max-w-md flex-col gap-6 px-4 py-8">
        {/* Profile */}
        <section className="flex flex-col gap-3">
          <h2 className="flex items-center gap-2 text-sm font-semibold text-neutral-400">
            <User className="size-4" />
            Profile
          </h2>
          <div className="flex flex-col gap-3 rounded-2xl bg-neutral-950 p-4">
            <label className="flex flex-col gap-1">
              <span className="text-xs text-neutral-500">Name</span>
              <input
                value={name}
                onChange={(e) => setName(e.target.value)}
                className="rounded-lg bg-neutral-900 p-3 text-sm text-white"
              />
            </label>
            <label className="flex flex-col gap-1">
              <span className="text-xs text-neutral-500">Email</span>
              <input
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                className="rounded-lg bg-neutral-900 p-3 text-sm text-white"
              />
            </label>
          </div>
        </section>

        {/* Payment methods */}
        <section className="flex flex-col gap-3">
          <h2 className="flex items-center gap-2 text-sm font-semibold text-neutral-400">
            <CreditCard className="size-4" />
            Payment methods
          </h2>
          <div className="flex flex-col gap-2">
            <button className="flex items-center justify-between rounded-2xl bg-neutral-950 px-4 py-3 text-left">
              <div>
                <p className="text-sm font-medium">Visa •••• 4242</p>
                <p className="text-xs text-neutral-500">Expires 12/28</p>
              </div>
              <ChevronRight className="size-5 text-neutral-500" />
            </button>
            <button className="flex items-center justify-center gap-2 rounded-2xl border border-dashed border-neutral-800 px-4 py-3 text-sm font-semibold text-primary">
              + Add payment method
            </button>
          </div>
        </section>

        {/* Notifications */}
        <section className="flex flex-col gap-3">
          <h2 className="flex items-center gap-2 text-sm font-semibold text-neutral-400">
            <Bell className="size-4" />
            Notifications
          </h2>
          <div className="flex flex-col divide-y divide-neutral-900 rounded-2xl bg-neutral-950">
            <ToggleRow
              label="Push notifications"
              checked={pushEnabled}
              onChange={setPushEnabled}
            />
            <ToggleRow
              label="Transaction alerts"
              checked={txAlerts}
              onChange={setTxAlerts}
            />
            <ToggleRow
              label="Marketing emails"
              checked={marketingEmails}
              onChange={setMarketingEmails}
            />
          </div>
        </section>

        <button className="w-full rounded-2xl bg-neutral-900 py-3 text-sm font-semibold text-red-400">
          Log out
        </button>
      </main>
    </div>
  )
}

function ToggleRow({
  label,
  checked,
  onChange,
}: {
  label: string
  checked: boolean
  onChange: (v: boolean) => void
}) {
  return (
    <div className="flex items-center justify-between px-4 py-3">
      <span className="text-sm">{label}</span>
      <button
        role="switch"
        aria-checked={checked}
        onClick={() => onChange(!checked)}
        className={`relative h-6 w-11 rounded-full transition-colors ${
          checked ? "bg-primary" : "bg-neutral-800"
        }`}
      >
        <span
          className={`absolute top-0.5 size-5 rounded-full bg-white transition-transform ${
            checked ? "translate-x-5" : "translate-x-0.5"
          }`}
        />
      </button>
    </div>
  )
}
